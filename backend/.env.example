# PostgreSQL (Supabase Session Pooler). Copia a .env y completa los valores reales; nunca los subas al repositorio.
DB_HOST=aws-0-us-east-2.pooler.supabase.com
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres.<project-ref>
DB_PASSWORD=<contraseña>
DB_SSLMODE=require

# Operaciones de arranque opcionales (por defecto desactivadas; no usar contra Supabase sin aprobación).
DB_CREATE_TABLES=false
DB_SEED_SIMULATED=false

CORS_ORIGINS=["http://localhost:5173"]
