# Modo local académico: SQLite y datos sintéticos, sin servidor externo.
DATABASE_URL=sqlite+pysqlite:///./data/respira.db
CORS_ORIGINS=["http://localhost:5173"]

# Para una futura instancia PostgreSQL, reemplaza DATABASE_URL con una URL local
# y configura credenciales únicamente en tu archivo .env, nunca aquí.
# DATABASE_URL=postgresql+psycopg://usuario:contraseña@localhost:5432/respira
