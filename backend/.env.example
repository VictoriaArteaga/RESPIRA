# PostgreSQL (Supabase Session Pooler). Copia a .env y completa los valores reales; nunca los subas al repositorio.
DB_HOST=aws-0-us-east-2.pooler.supabase.com
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres.<project-ref>
DB_PASSWORD=<contraseña>
DB_SSLMODE=require

# Operaciones de arranque opcionales (por defecto desactivadas; no usar contra Supabase sin aprobación).
DB_CREATE_TABLES=false
DB_SEED_SIMULATED=false

# Autenticación JWT. Genera la clave con:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# Debe tener al menos 32 caracteres, ser única por entorno y no versionarse.
# Sin valor por defecto: la API no arranca si falta o tiene menos de 32 caracteres.
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

CORS_ORIGINS=["http://localhost:5173"]
